diff --git a/mobile/__mocks__/react-native-audio-api.ts b/mobile/__mocks__/react-native-audio-api.ts
new file mode 100644
index 0000000..4efa20e
--- /dev/null
+++ b/mobile/__mocks__/react-native-audio-api.ts
@@ -0,0 +1,186 @@
+/**
+ * Stands in for `react-native-audio-api` under Jest.
+ *
+ * This library is the microphone and the speaker — executorch supplies neither.
+ * The mock lets a test drive what the mic "heard" (`__mockSetRecordedChunks`)
+ * and assert what reached the speaker (`__mockPlayedBuffers`).
+ */
+
+type PermissionStatus = 'Undetermined' | 'Denied' | 'Granted';
+
+type CallbackOptions = {
+  sampleRate: number;
+  bufferLength: number;
+  channelCount: number;
+};
+
+type AudioReadyEvent = {
+  buffer: {
+    sampleRate: number;
+    getChannelData: (channel: number) => Float32Array;
+  };
+  numFrames: number;
+};
+
+const state = {
+  recordedChunks: [] as Float32Array[],
+  recordedSampleRate: 16000,
+  permission: 'Granted' as PermissionStatus,
+  permissionRequestResult: 'Granted' as PermissionStatus,
+  startError: null as Error | null,
+  played: [] as { samples: Float32Array; sampleRate: number }[],
+  permissionRequests: 0,
+};
+
+export function __mockResetAudioApi(): void {
+  state.recordedChunks = [];
+  state.recordedSampleRate = 16000;
+  state.permission = 'Granted';
+  state.permissionRequestResult = 'Granted';
+  state.startError = null;
+  state.played = [];
+  state.permissionRequests = 0;
+}
+
+/** Audio the microphone will deliver on the next recording. */
+export function __mockSetRecordedChunks(chunks: Float32Array[], sampleRate = 16000): void {
+  state.recordedChunks = chunks;
+  state.recordedSampleRate = sampleRate;
+}
+
+/** The permission state before anything is asked. */
+export function __mockSetPermission(status: PermissionStatus): void {
+  state.permission = status;
+}
+
+/** What the learner chooses when the system prompt appears. */
+export function __mockSetPermissionRequestResult(status: PermissionStatus): void {
+  state.permissionRequestResult = status;
+}
+
+export function __mockFailRecorderStart(error: Error): void {
+  state.startError = error;
+}
+
+export function __mockPlayedBuffers(): { samples: Float32Array; sampleRate: number }[] {
+  return state.played;
+}
+
+export function __mockPermissionRequestCount(): number {
+  return state.permissionRequests;
+}
+
+export class AudioRecorder {
+  private callback: ((event: AudioReadyEvent) => void) | null = null;
+  private recording = false;
+
+  onAudioReady(_options: CallbackOptions, callback: (event: AudioReadyEvent) => void) {
+    this.callback = callback;
+    return { status: 'success' as const };
+  }
+
+  clearOnAudioReady(): void {
+    this.callback = null;
+  }
+
+  async start(): Promise<{ status: 'success' } | { status: 'error' }> {
+    if (state.startError) {
+      throw state.startError;
+    }
+    this.recording = true;
+    for (const chunk of state.recordedChunks) {
+      this.callback?.({
+        buffer: {
+          sampleRate: state.recordedSampleRate,
+          getChannelData: () => chunk,
+        },
+        numFrames: chunk.length,
+      });
+    }
+    return { status: 'success' };
+  }
+
+  async stop(): Promise<{ status: 'success' } | { status: 'error' }> {
+    this.recording = false;
+    return { status: 'success' };
+  }
+
+  isRecording(): boolean {
+    return this.recording;
+  }
+
+  onError(_callback: (error: unknown) => void): void {}
+  clearOnError(): void {}
+}
+
+class MockAudioBuffer {
+  readonly channelData: Float32Array;
+
+  constructor(
+    readonly numberOfChannels: number,
+    readonly length: number,
+    readonly sampleRate: number,
+  ) {
+    this.channelData = new Float32Array(length);
+  }
+
+  getChannelData(): Float32Array {
+    return this.channelData;
+  }
+
+  copyToChannel(source: Float32Array, _channel: number, startInChannel = 0): void {
+    this.channelData.set(source, startInChannel);
+  }
+}
+
+class MockBufferSource {
+  buffer: MockAudioBuffer | null = null;
+  onEnded: (() => void) | null = null;
+
+  connect(_destination: unknown): void {}
+  disconnect(): void {}
+
+  start(): void {
+    if (this.buffer) {
+      state.played.push({
+        samples: this.buffer.getChannelData(),
+        sampleRate: this.buffer.sampleRate,
+      });
+    }
+    this.onEnded?.();
+  }
+
+  stop(): void {}
+}
+
+export class AudioContext {
+  readonly destination = {};
+  readonly sampleRate: number;
+
+  constructor(options?: { sampleRate?: number }) {
+    this.sampleRate = options?.sampleRate ?? 44100;
+  }
+
+  createBuffer(numberOfChannels: number, length: number, sampleRate: number) {
+    return new MockAudioBuffer(numberOfChannels, length, sampleRate);
+  }
+
+  createBufferSource() {
+    return new MockBufferSource();
+  }
+
+  async close(): Promise<void> {}
+}
+
+export const AudioManager = {
+  async checkRecordingPermissions(): Promise<PermissionStatus> {
+    return state.permission;
+  },
+  async requestRecordingPermissions(): Promise<PermissionStatus> {
+    state.permissionRequests += 1;
+    state.permission = state.permissionRequestResult;
+    return state.permission;
+  },
+  setAudioSessionOptions(_options: unknown): void {},
+  async setAudioSessionActivity(_enabled: boolean): Promise<void> {},
+};
diff --git a/mobile/__mocks__/react-native-executorch-expo-resource-fetcher.ts b/mobile/__mocks__/react-native-executorch-expo-resource-fetcher.ts
new file mode 100644
index 0000000..c48d3a7
--- /dev/null
+++ b/mobile/__mocks__/react-native-executorch-expo-resource-fetcher.ts
@@ -0,0 +1,109 @@
+/**
+ * Stands in for the executorch Expo resource fetcher under Jest.
+ *
+ * The real fetcher downloads into `RNEDirectory` via a cache-then-move, so a
+ * half-written file never appears in the directory `listDownloadedFiles` reads.
+ * This mock keeps that property: `fetch` only records a file as present once it
+ * resolves, so an interrupted download leaves nothing behind.
+ */
+
+const RNE_DIRECTORY = 'file:///mock-documents/react-native-executorch/';
+
+function filenameFromUri(uri: string): string {
+  let cleanUri = uri.replace(/^https?:\/\//, '');
+  cleanUri = cleanUri.split('#')?.[0] ?? cleanUri;
+  return cleanUri.replace(/[^a-zA-Z0-9._-]/g, '_');
+}
+
+const state = {
+  downloaded: new Set<string>(),
+  sizeByUri: new Map<string, number>(),
+  fetchError: null as Error | null,
+  sizeError: null as Error | null,
+  progressSteps: [0.5, 1] as number[],
+  fetchCallCount: 0,
+};
+
+export function __mockResetResourceFetcher(): void {
+  state.downloaded.clear();
+  state.sizeByUri.clear();
+  state.fetchError = null;
+  state.sizeError = null;
+  state.progressSteps = [0.5, 1];
+  state.fetchCallCount = 0;
+}
+
+/** Marks these source URLs as already present on disk. */
+export function __mockMarkDownloaded(...uris: string[]): void {
+  for (const uri of uris) {
+    state.downloaded.add(filenameFromUri(uri));
+  }
+}
+
+export function __mockSetRemoteSize(uri: string, bytes: number): void {
+  state.sizeByUri.set(uri, bytes);
+}
+
+export function __mockFailFetch(error: Error): void {
+  state.fetchError = error;
+}
+
+export function __mockFailSizeProbe(error: Error): void {
+  state.sizeError = error;
+}
+
+export function __mockFetchCallCount(): number {
+  return state.fetchCallCount;
+}
+
+export const ExpoResourceFetcher = {
+  async listDownloadedFiles(): Promise<string[]> {
+    return [...state.downloaded].map((filename) => `${RNE_DIRECTORY}${filename}`);
+  },
+
+  async getFilesTotalSize(...sources: unknown[]): Promise<number> {
+    if (state.sizeError) {
+      throw state.sizeError;
+    }
+    return sources.reduce<number>(
+      (total, source) =>
+        total + (typeof source === 'string' ? (state.sizeByUri.get(source) ?? 0) : 0),
+      0,
+    );
+  },
+
+  async fetch(
+    callback?: (progress: number) => void,
+    ...sources: unknown[]
+  ): Promise<string[]> {
+    state.fetchCallCount += 1;
+    for (const step of state.progressSteps) {
+      callback?.(step);
+    }
+    if (state.fetchError) {
+      // Interrupted: nothing lands in the directory, mirroring the real
+      // cache-then-move behaviour.
+      throw state.fetchError;
+    }
+    const paths: string[] = [];
+    for (const source of sources) {
+      if (typeof source !== 'string') {
+        continue;
+      }
+      const filename = filenameFromUri(source);
+      state.downloaded.add(filename);
+      paths.push(`${RNE_DIRECTORY}${filename}`);
+    }
+    return paths;
+  },
+
+  async deleteResources(...sources: unknown[]): Promise<void> {
+    for (const source of sources) {
+      if (typeof source === 'string') {
+        state.downloaded.delete(filenameFromUri(source));
+      }
+    }
+  },
+
+  async cancelFetching(..._sources: unknown[]): Promise<void> {},
+};
diff --git a/mobile/__mocks__/react-native-executorch.ts b/mobile/__mocks__/react-native-executorch.ts
new file mode 100644
index 0000000..f23ce98
--- /dev/null
+++ b/mobile/__mocks__/react-native-executorch.ts
@@ -0,0 +1,163 @@
+/**
+ * Stands in for the pinned `react-native-executorch` nightly under Jest.
+ *
+ * The real package is a native module: it cannot load in node, and its model
+ * URLs point at multi-hundred-megabyte files. Only the surface `data/ai/voice/`
+ * actually calls is reproduced here — `models`, the two module classes, and the
+ * filename helper the download manager uses to check what is on disk.
+ *
+ * `getFilenameFromUri` mirrors the real implementation exactly, because the
+ * download manager's presence check depends on that derivation matching what
+ * the fetcher wrote.
+ */
+
+type SttModule = {
+  transcribe: (waveform: Float32Array, options?: { language?: string }) => Promise<{ text: string }>;
+  delete: () => void;
+};
+
+type TtsModule = {
+  forward: (input: string) => Promise<Float32Array>;
+  delete: () => void;
+};
+
+const state = {
+  transcription: '',
+  synthesis: new Float32Array(0) as Float32Array<ArrayBufferLike>,
+  sttLoadError: null as Error | null,
+  ttsLoadError: null as Error | null,
+  transcribeError: null as Error | null,
+  synthesizeError: null as Error | null,
+  initCount: 0,
+  sttLoadCount: 0,
+  ttsLoadCount: 0,
+  transcribeCalls: [] as { waveform: Float32Array; language?: string }[],
+  synthesizeCalls: [] as string[],
+};
+
+export function __mockResetExecutorch(): void {
+  state.transcription = '';
+  state.synthesis = new Float32Array(0);
+  state.sttLoadError = null;
+  state.ttsLoadError = null;
+  state.transcribeError = null;
+  state.synthesizeError = null;
+  state.initCount = 0;
+  state.sttLoadCount = 0;
+  state.ttsLoadCount = 0;
+  state.transcribeCalls = [];
+  state.synthesizeCalls = [];
+}
+
+export function __mockSetTranscription(text: string): void {
+  state.transcription = text;
+}
+
+export function __mockSetSynthesis(samples: Float32Array): void {
+  state.synthesis = samples;
+}
+
+export function __mockFailSttLoad(error: Error): void {
+  state.sttLoadError = error;
+}
+
+export function __mockFailTtsLoad(error: Error): void {
+  state.ttsLoadError = error;
+}
+
+export function __mockFailTranscribe(error: Error): void {
+  state.transcribeError = error;
+}
+
+export function __mockFailSynthesize(error: Error): void {
+  state.synthesizeError = error;
+}
+
+export function __mockExecutorchState() {
+  return state;
+}
+
+export function initExecutorch(_config: unknown): void {
+  state.initCount += 1;
+}
+
+export const models = {
+  speech_to_text: {
+    whisper_small: () => ({
+      modelName: 'whisper-small' as const,
+      isMultilingual: true as const,
+      modelSource: 'https://models.test/whisper/whisper_small.pte',
+      tokenizerSource: 'https://models.test/whisper/tokenizer.json',
+    }),
+  },
+  text_to_speech: {
+    supertonic: {
+      f1: () => ({
+        model: {
+          modelName: 'supertonic' as const,
+          unicodeIndexerSource: 'https://models.test/supertonic/indexer.pte',
+          durationPredictorSource: 'https://models.test/supertonic/duration.pte',
+          textEncoderSource: 'https://models.test/supertonic/encoder.pte',
+          vectorEstimatorSource: 'https://models.test/supertonic/vector.pte',
+          vocoderSource: 'https://models.test/supertonic/vocoder.pte',
+        },
+        voiceSource: 'https://models.test/supertonic/voice_f1.bin',
+      }),
+    },
+  },
+};
+
+export const SpeechToTextModule = {
+  async fromModelName(
+    _config: unknown,
+    _vad?: unknown,
+    onDownloadProgress?: (progress: number) => void,
+  ): Promise<SttModule> {
+    state.sttLoadCount += 1;
+    onDownloadProgress?.(1);
+    if (state.sttLoadError) {
+      throw state.sttLoadError;
+    }
+    return {
+      async transcribe(waveform, options) {
+        state.transcribeCalls.push({ waveform, language: options?.language });
+        if (state.transcribeError) {
+          throw state.transcribeError;
+        }
+        return { text: state.transcription };
+      },
+      delete() {},
+    };
+  },
+};
+
+export const TextToSpeechModule = {
+  async fromModelName(
+    _config: unknown,
+    onDownloadProgress?: (progress: number) => void,
+  ): Promise<TtsModule> {
+    state.ttsLoadCount += 1;
+    onDownloadProgress?.(1);
+    if (state.ttsLoadError) {
+      throw state.ttsLoadError;
+    }
+    return {
+      async forward(input) {
+        state.synthesizeCalls.push(input);
+        if (state.synthesizeError) {
+          throw state.synthesizeError;
+        }
+        return state.synthesis;
+      },
+      delete() {},
+    };
+  },
+};
+
+export const ResourceFetcherUtils = {
+  getFilenameFromUri(uri: string): string {
+    let cleanUri = uri.replace(/^https?:\/\//, '');
+    cleanUri = cleanUri.split('#')?.[0] ?? cleanUri;
+    return cleanUri.replace(/[^a-zA-Z0-9._-]/g, '_');
+  },
+};
