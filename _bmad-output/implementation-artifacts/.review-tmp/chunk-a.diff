+import {
+  __mockFailFetch,
+  __mockFailSizeProbe,
+  __mockFetchCallCount,
+  __mockMarkDownloaded,
+  __mockResetResourceFetcher,
+  __mockSetRemoteSize,
+} from '../../../../__mocks__/react-native-executorch-expo-resource-fetcher';
+
+import {
+  areVoiceModelsDownloaded,
+  downloadVoiceModels,
+  getVoiceModelDownloadBytes,
+} from '@/data/ai/voice/modelDownloadManager';
+import { voiceModelSources } from '@/data/ai/voice/voiceModels';
+
+describe('modelDownloadManager', () => {
+  beforeEach(() => {
+    __mockResetResourceFetcher();
+  });
+
+  describe('areVoiceModelsDownloaded', () => {
+    it('reports false when no model file is on disk', async () => {
+      const result = await areVoiceModelsDownloaded();
+
+      expect(result).toEqual({ ok: true, value: false });
+    });
+
+    it('reports false when only some model files are present', async () => {
+      const sources = voiceModelSources();
+      __mockMarkDownloaded(...(sources.slice(0, 2) as string[]));
+
+      const result = await areVoiceModelsDownloaded();
+
+      expect(result).toEqual({ ok: true, value: false });
+    });
+
+    it('reports true only once every model file is present', async () => {
+      __mockMarkDownloaded(...(voiceModelSources() as string[]));
+
+      const result = await areVoiceModelsDownloaded();
+
+      expect(result).toEqual({ ok: true, value: true });
+    });
+  });
+
+  describe('getVoiceModelDownloadBytes', () => {
+    it('sums the real remote sizes of every model file', async () => {
+      const sources = voiceModelSources() as string[];
+      for (const source of sources) {
+        __mockSetRemoteSize(source, 1_000_000);
+      }
+
+      const result = await getVoiceModelDownloadBytes();
+
+      expect(result).toEqual({ ok: true, value: sources.length * 1_000_000 });
+    });
+
+    it('returns an error rather than a guessed size when the probe fails', async () => {
+      __mockFailSizeProbe(new Error('offline'));
+
+      const result = await getVoiceModelDownloadBytes();
+
+      expect(result.ok).toBe(false);
+      if (!result.ok) {
+        expect(result.error.code).toBe('voice_model_size_unavailable');
+      }
+    });
+  });
+
+  describe('downloadVoiceModels', () => {
+    it('downloads every model source and reports progress', async () => {
+      const progress: number[] = [];
+
+      const result = await downloadVoiceModels((value) => progress.push(value));
+
+      expect(result.ok).toBe(true);
+      expect(progress).toEqual([0.5, 1]);
+      await expect(areVoiceModelsDownloaded()).resolves.toEqual({ ok: true, value: true });
+    });
+
+    it('leaves nothing behind that a presence check would mistake for a complete download', async () => {
+      __mockFailFetch(new Error('connection lost'));
+
+      const result = await downloadVoiceModels();
+
+      expect(result.ok).toBe(false);
+      if (!result.ok) {
+        expect(result.error.code).toBe('voice_model_download_failed');
+      }
+      await expect(areVoiceModelsDownloaded()).resolves.toEqual({ ok: true, value: false });
+    });
+
+    it('does not start a download merely by importing the module', () => {
+      expect(__mockFetchCallCount()).toBe(0);
+    });
+  });
+});
diff --git a/mobile/src/data/ai/voice/modelDownloadManager.ts b/mobile/src/data/ai/voice/modelDownloadManager.ts
new file mode 100644
index 0000000..472e3f2
--- /dev/null
+++ b/mobile/src/data/ai/voice/modelDownloadManager.ts
@@ -0,0 +1,99 @@
+import { ResourceFetcherUtils } from 'react-native-executorch';
+import { ExpoResourceFetcher } from 'react-native-executorch-expo-resource-fetcher';
+
+import { ensureExecutorchInitialised } from '@/data/ai/voice/executorchRuntime';
+import { voiceModelSources } from '@/data/ai/voice/voiceModels';
+import type { AppError, Result } from '@/types/result.types';
+
+/**
+ * Explicit, learner-initiated download of the voice models (AC5, NFR25, UX-DR23).
+ *
+ * Nothing here runs unless the learner taps the mic and confirms — no cold-start
+ * work, no background fetch, no "warm the cache" call.
+ *
+ * Presence is a filesystem fact, checked every time. The fetcher downloads into
+ * the cache directory and only moves the file into its model directory once the
+ * transfer completes, so a listing of that directory cannot show a half-written
+ * file. That is why there is no "download succeeded" flag anywhere — a flag can
+ * drift from the disk, and a stale one pointing at a missing model is exactly
+ * the silent failure this feature must not have.
+ */
+
+function fileNameOf(source: unknown): string | null {
+  return typeof source === 'string' ? ResourceFetcherUtils.getFilenameFromUri(source) : null;
+}
+
+function toError(code: string, userMessage: string, cause: unknown): AppError {
+  return { code, message: String(cause), userMessage, cause };
+}
+
+export async function areVoiceModelsDownloaded(): Promise<Result<boolean>> {
+  ensureExecutorchInitialised();
+  try {
+    const present = new Set(
+      (await ExpoResourceFetcher.listDownloadedFiles()).map((path) =>
+        path.slice(path.lastIndexOf('/') + 1),
+      ),
+    );
+    const required = voiceModelSources().map(fileNameOf);
+    return {
+      ok: true,
+      value: required.every((name) => name !== null && present.has(name)),
+    };
+  } catch (cause) {
+    return {
+      ok: false,
+      error: toError(
+        'voice_model_check_failed',
+        'Could not check whether the voice models are downloaded.',
+        cause,
+      ),
+    };
+  }
+}
+
+/**
+ * The real combined size of the model files, read from the server.
+ *
+ * A failure is returned rather than substituted with an estimate: the download
+ * prompt has to disclose a true size, and a device that cannot reach the model
+ * host cannot download them anyway.
+ */
+export async function getVoiceModelDownloadBytes(): Promise<Result<number>> {
+  ensureExecutorchInitialised();
+  try {
+    const bytes = await ExpoResourceFetcher.getFilesTotalSize(...voiceModelSources());
+    return { ok: true, value: bytes };
+  } catch (cause) {
+    return {
+      ok: false,
+      error: toError(
+        'voice_model_size_unavailable',
+        'Could not reach the voice model download. Check your connection and try again.',
+        cause,
+      ),
+    };
+  }
+}
+
+export async function downloadVoiceModels(
+  onProgress?: (progress: number) => void,
+): Promise<Result<void>> {
+  ensureExecutorchInitialised();
+  try {
+    await ExpoResourceFetcher.fetch(
+      (progress) => onProgress?.(progress),
+      ...voiceModelSources(),
+    );
+    return { ok: true, value: undefined };
+  } catch (cause) {
+    return {
+      ok: false,
+      error: toError(
+        'voice_model_download_failed',
+        'The voice model download did not finish. You can try again.',
+        cause,
+      ),
+    };
+  }
+}
