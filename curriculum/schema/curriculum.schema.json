{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://japanese-learning.app/curriculum.schema.json",
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "jlpt_levels", "description"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "jlpt_levels": {
          "type": "array",
          "items": { "type": "string", "enum": ["N5", "N4", "N3", "N2", "N1"] },
          "minItems": 1
        },
        "description": { "type": "string", "minLength": 1 },
        "maintainer_notes": { "type": "string" },
        "content_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "radicals": { "type": "integer", "minimum": 0 },
            "kanji": { "type": "integer", "minimum": 0 },
            "vocabulary": { "type": "integer", "minimum": 0 },
            "grammar": { "type": "integer", "minimum": 0 },
            "total_items": { "type": "integer", "minimum": 0 },
            "reading_passages": { "type": "integer", "minimum": 0 },
            "dependency_edges": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "sidecarMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generator_model": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "review_status": { "type": "string", "enum": ["draft", "reviewed", "flagged_for_rewrite"] },
        "reviewed_by": { "type": "string", "minLength": 1 }
      }
    },
    "radicalItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "primary_form", "meaning"],
      "properties": {
        "_meta": { "$ref": "#/$defs/sidecarMeta" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "primary_form": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1 },
        "mnemonic_text": { "type": "string" },
        "image_prompt": {
          "description": "The stroke-walked scene the radical's Tier 2 illustration is drawn from — the longer, fully specified version of mnemonic_text, kept for the art pipeline. Never shown to the learner; compile-curriculum leaves it out of the bundled db. Radicals only.",
          "type": "string"
        },
        "description": { "type": "string", "minLength": 1 },
        "visually_similar_slugs": {
          "description": "Look-alikes as \"<kind>:<slug>\" (\"kanji:person\", \"radical:hito\"). A radical and a kanji may share a slug, so the kind is part of the reference.",
          "type": "array",
          "items": { "type": "string", "pattern": "^(radical|kanji):[a-z0-9-]+$" },
          "uniqueItems": true
        },
        "visual_mnemonic_url": {
          "description": "Optional: skeleton-level radicals (kanji-coverage plan Phase 2) ship with no art, and a ref to a file nobody has drawn would be a lie. Every authored radical carries one. The ref is `radicals/<slug>.webp` and holds no level, so a radical that moves to another level keeps its art.",
          "type": "string",
          "pattern": "^radicals/[a-z0-9-]+\\.webp$"
        },
        "sort_order": { "type": "integer", "minimum": 0 },
        "accepted_answers": {
          "type": "array",
          "items": { "$ref": "#/$defs/acceptedAnswer" }
        }
      }
    },
    "radicalsFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jlpt_level", "items"],
      "properties": {
        "jlpt_level": { "type": "string", "enum": ["N5", "N4", "N3", "N2", "N1"] },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/radicalItem" },
          "minItems": 1
        }
      }
    },
    "kanjiReading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reading_type", "reading"],
      "properties": {
        "reading_type": { "type": "string", "enum": ["onyomi", "kunyomi"] },
        "reading": { "type": "string", "minLength": 1 },
        "sort_order": { "type": "integer", "minimum": 0 }
      }
    },
    "acceptedAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer_type", "answer_text"],
      "properties": {
        "answer_type": { "type": "string", "enum": ["meaning", "reading", "production"] },
        "answer_text": { "type": "string", "minLength": 1 },
        "is_primary": { "type": "boolean" }
      }
    },
    "kanjiItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "primary_form", "meaning"],
      "properties": {
        "_meta": { "$ref": "#/$defs/sidecarMeta" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "primary_form": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1 },
        "mnemonic_text": { "type": "string" },
        "meaning_mnemonic": { "type": "string", "minLength": 1 },
        "reading_mnemonic": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "visually_similar_slugs": {
          "description": "Look-alikes as \"<kind>:<slug>\" (\"kanji:person\", \"radical:hito\"). A radical and a kanji may share a slug, so the kind is part of the reference.",
          "type": "array",
          "items": { "type": "string", "pattern": "^(radical|kanji):[a-z0-9-]+$" },
          "uniqueItems": true
        },
        "sort_order": { "type": "integer", "minimum": 0 },
        "readings": {
          "type": "array",
          "items": { "$ref": "#/$defs/kanjiReading" }
        },
        "accepted_answers": {
          "type": "array",
          "items": { "$ref": "#/$defs/acceptedAnswer" }
        }
      }
    },
    "kanjiFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jlpt_level", "items"],
      "properties": {
        "jlpt_level": { "type": "string", "enum": ["N5", "N4", "N3", "N2", "N1"] },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/kanjiItem" },
          "minItems": 1
        }
      }
    },
    "vocabItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "primary_form", "meaning"],
      "properties": {
        "_meta": { "$ref": "#/$defs/sidecarMeta" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "primary_form": { "type": "string", "minLength": 1 },
        "furigana": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1 },
        "word_type": { "type": "string", "minLength": 1 },
        "reading_composition": { "type": "string", "minLength": 1 },
        "mnemonic_text": { "type": "string" },
        "meaning_mnemonic": { "type": "string", "minLength": 1 },
        "reading_mnemonic": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "sort_order": { "type": "integer", "minimum": 0 },
        "accepted_answers": {
          "type": "array",
          "items": { "$ref": "#/$defs/acceptedAnswer" }
        },
        "example_sentences": {
          "type": "array",
          "items": { "$ref": "#/$defs/exampleSentence" }
        }
      }
    },
    "vocabularyFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jlpt_level", "items"],
      "properties": {
        "jlpt_level": { "type": "string", "enum": ["N5", "N4", "N3", "N2", "N1"] },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/vocabItem" },
          "minItems": 1
        }
      }
    },
    "exampleSentence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["japanese", "english"],
      "properties": {
        "japanese": { "type": "string", "minLength": 1 },
        "furigana": { "type": "string", "minLength": 1 },
        "english": { "type": "string", "minLength": 1 },
        "sort_order": { "type": "integer", "minimum": 0 },
        "reinforcement_tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "vocabulary_slugs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "uniqueItems": true
        },
        "word_spans": {
          "type": "array",
          "items": { "$ref": "#/$defs/wordSpan" }
        },
        "grammar_span": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 1 }
          }
        },
        "register": { "type": "string", "enum": ["polite", "plain"] },
        "build_alternates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["furigana", "kind"],
            "properties": {
              "furigana": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "enum": ["valid", "other_grammar"] }
            }
          }
        }
      }
    },
    "grammarUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "structure", "japanese", "english"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "structure": { "type": "string", "minLength": 1 },
        "japanese": { "type": "string", "minLength": 1 },
        "furigana": { "type": "string", "minLength": 1 },
        "english": { "type": "string", "minLength": 1 }
      }
    },
    "grammarItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "primary_form", "meaning", "structure", "conjugation_rules", "accepted_forms"],
      "properties": {
        "_meta": { "$ref": "#/$defs/sidecarMeta" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "primary_form": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1 },
        "explanation_markdown": { "type": "string", "minLength": 1 },
        "caution_notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "related_grammar_slugs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "uniqueItems": true
        },
        "sort_order": { "type": "integer", "minimum": 0 },
        "structure": { "type": "string", "minLength": 1 },
        "conjugation_rules": { "type": "object" },
        "accepted_forms": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "family": {
          "type": "string",
          "enum": ["particles", "copula", "conjugations", "connectors", "patterns"]
        },
        "uses": {
          "type": "array",
          "items": { "$ref": "#/$defs/grammarUse" },
          "minItems": 2
        },
        "example_sentences": {
          "type": "array",
          "items": { "$ref": "#/$defs/exampleSentence" }
        },
        "accepted_answers": {
          "type": "array",
          "items": { "$ref": "#/$defs/acceptedAnswer" }
        },
        "vocabulary_slugs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        }
      }
    },
    "grammarFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jlpt_level", "items"],
      "properties": {
        "jlpt_level": { "type": "string", "enum": ["N5", "N4", "N3", "N2", "N1"] },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/grammarItem" },
          "minItems": 1
        }
      }
    },
    "passageQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "accepted_answers"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "prompt_furigana": { "type": "string", "minLength": 1 },
        "accepted_answers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "sort_order": { "type": "integer", "minimum": 0 }
      }
    },
    "wordSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vocabulary_slug", "start", "end"],
      "properties": {
        "vocabulary_slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "start": { "type": "integer", "minimum": 0 },
        "end": {
          "type": "integer",
          "exclusiveMinimum": { "$data": "1/start" }
        },
        "surface_form": { "type": "string", "minLength": 1 },
        "inflection": { "type": "string", "enum": ["masu", "te", "nai", "ta", "stem"] }
      },
      "dependencies": {
        "surface_form": ["inflection"],
        "inflection": ["surface_form"]
      }
    },
    "readingPassage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "body"],
      "properties": {
        "_meta": { "$ref": "#/$defs/sidecarMeta" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "body_furigana": { "type": "string", "minLength": 1 },
        "english_translation": { "type": "string", "minLength": 1 },
        "summary_ja": { "type": "string", "minLength": 1 },
        "summary_en": { "type": "string", "minLength": 1 },
        "word_spans": {
          "type": "array",
          "items": { "$ref": "#/$defs/wordSpan" }
        },
        "grammar_slugs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "uniqueItems": true
        },
        "vocabulary_slugs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "uniqueItems": true
        },
        "word_count": { "type": "integer", "minimum": 1 },
        "sort_order": { "type": "integer", "minimum": 0 },
        "questions": {
          "type": "array",
          "items": { "$ref": "#/$defs/passageQuestion" }
        }
      }
    },
    "readingsFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jlpt_level", "passages"],
      "properties": {
        "jlpt_level": { "type": "string", "enum": ["N5", "N4", "N3", "N2", "N1"] },
        "passages": {
          "type": "array",
          "items": { "$ref": "#/$defs/readingPassage" },
          "minItems": 1
        }
      }
    },
    "dependencyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_slug", "from_type", "to_slug", "to_type", "relationship_type"],
      "properties": {
        "from_slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "from_type": { "type": "string", "enum": ["radical", "kanji", "vocabulary", "grammar"] },
        "to_slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "to_type": { "type": "string", "enum": ["radical", "kanji", "vocabulary", "grammar"] },
        "relationship_type": {
          "type": "string",
          "enum": ["requires", "builds_on", "reinforces"]
        }
      }
    },
    "dependenciesFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edges"],
      "properties": {
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependencyEdge" },
          "minItems": 1
        }
      }
    },
    "idRegistrySection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_id", "ids", "retired", "aliases"],
      "properties": {
        "next_id": { "type": "integer", "minimum": 1 },
        "ids": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "retired": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "aliases": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "idRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "passages", "passage_questions"],
      "properties": {
        "items": { "$ref": "#/$defs/idRegistrySection" },
        "passages": { "$ref": "#/$defs/idRegistrySection" },
        "passage_questions": { "$ref": "#/$defs/idRegistrySection" }
      }
    }
  }
}
