{
  "name": "pakapaka-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../mobile/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "routes": [{ "pattern": "paka-paka.app", "custom_domain": true }],
  "vars": {
    "APP_ORIGIN": "https://paka-paka.app",
    "GOOGLE_WEB_CLIENT_ID": "68070992356-b6bralepm3637rkf8sas9dfj10bu85jp.apps.googleusercontent.com",
    "GOOGLE_IOS_CLIENT_IDS": "68070992356-2c4mub75suml0vnl5hu068agqsff1pf3.apps.googleusercontent.com,68070992356-qjruuekdmqqne6t2168ur0r9limc5npe.apps.googleusercontent.com,68070992356-i9d5heeej7a6v1e2th86g0l2omffmbu5.apps.googleusercontent.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGCAhfDyxQYa5lFE"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pakapaka",
      "database_id": "182b98c9-664a-4f69-bba9-b32af9bd40be",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "PROGRESS", "bucket_name": "pakapaka-progress" },
    { "binding": "CURRICULUM", "bucket_name": "pakapaka-curriculum" }
  ],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "UPLOAD_LIMITER", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } }
  ],
  "triggers": { "crons": ["0 1 * * *"] },
  "send_email": [{ "name": "ALERT_EMAIL" }]
}
