{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "clsx": "^2.1.1",
    "expo": "~55.0.23",
    "expo-asset": "~55.0.17",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.15",
    "expo-device": "~55.0.16",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.22",
    "expo-font": "~55.0.7",
    "expo-glass-effect": "~55.0.11",
    "expo-image": "~55.0.10",
    "expo-linking": "~55.0.15",
    "expo-network": "~55.0.14",
    "expo-router": "~55.0.14",
    "expo-screen-orientation": "~55.0.16",
    "expo-secure-store": "~55.0.14",
    "expo-splash-screen": "~55.0.20",
    "expo-sqlite": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.8",
    "expo-system-ui": "~55.0.17",
    "expo-updates": "~55.0.21",
    "expo-web-browser": "~55.0.15",
    "jszip": "^3.10.1",
    "nativewind": "^4.1.23",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "semver": "^7.8.1",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "^5.4.1",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/jszip": "^3.4.0",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "@types/semver": "^7.7.1",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.17",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)",
      "**/src/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/test-support/(.*)$": "<rootDir>/test-support/$1",
      "^@/(.*)$": "<rootDir>/src/$1",
      "^expo-sqlite$": "<rootDir>/__mocks__/expo-sqlite.ts",
      "^expo-file-system/legacy$": "<rootDir>/__mocks__/expo-file-system.ts",
      "^expo-network$": "<rootDir>/__mocks__/expo-network.ts",
      "^expo-crypto$": "<rootDir>/__mocks__/expo-crypto.ts",
      "^expo-secure-store$": "<rootDir>/__mocks__/expo-secure-store.ts",
      "^expo-asset$": "<rootDir>/__mocks__/expo-asset.ts",
      "^expo-image$": "<rootDir>/__mocks__/expo-image.tsx",
      "^expo-document-picker$": "<rootDir>/__mocks__/expo-document-picker.ts"
    }
  }
}
