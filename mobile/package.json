{
  "name": "pakapaka",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "APP_VARIANT=development expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "generate-radical-assets": "node ./scripts/generate-radical-asset-map.js",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "build:web": "expo export -p web",
    "deploy:web": "npm run build:web && npm --prefix ../backend run deploy",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "eas:preview": "npx eas-cli build --profile preview --platform android --non-interactive --no-wait"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-jp": "^0.4.3",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo-google-fonts/zen-kaku-gothic-new": "^0.4.1",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "clsx": "^2.1.1",
    "expo": "~55.0.27",
    "expo-asset": "~55.0.17",
    "expo-build-properties": "~55.0.16",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.16",
    "expo-dev-client": "~55.0.36",
    "expo-device": "~55.0.18",
    "expo-document-picker": "~55.0.14",
    "expo-file-system": "~55.0.22",
    "expo-font": "~55.0.7",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-linking": "~55.0.16",
    "expo-network": "~55.0.15",
    "expo-notifications": "~55.0.24",
    "expo-router": "~55.0.16",
    "expo-screen-orientation": "~55.0.17",
    "expo-secure-store": "~55.0.15",
    "expo-sharing": "~55.0.22",
    "expo-splash-screen": "~55.0.22",
    "expo-sqlite": "~55.0.17",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.19",
    "expo-updates": "~55.0.25",
    "expo-web-browser": "~55.0.17",
    "jszip": "^3.10.1",
    "nativewind": "^4.1.23",
    "pako": "^2.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-audio-api": "0.13.2",
    "react-native-executorch": "0.10.0-nightly-a0bf85b-20260721",
    "react-native-executorch-expo-resource-fetcher": "0.10.0-nightly-0a8fe7e-20260527",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-nitro-google-signin": "^2.3.1",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "semver": "^7.8.1",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "^5.4.1",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/jszip": "^3.4.0",
    "@types/pako": "^2.0.4",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "@types/semver": "^7.7.1",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.19",
    "patch-package": "^8.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)",
      "**/src/**/*.test.ts?(x)"
    ],
    "setupFilesAfterEnv": [
      "react-native-gesture-handler/jestSetup"
    ],
    "moduleNameMapper": {
      "^@/assets/curriculum-seed/curriculum-seed\\.json$": "<rootDir>/test-support/curriculum-seed.json",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/test-support/(.*)$": "<rootDir>/test-support/$1",
      "^@/(.*)$": "<rootDir>/src/$1",
      "^react-native-reanimated$": "<rootDir>/node_modules/react-native-reanimated/mock.js",
      "^react-native-worklets$": "<rootDir>/node_modules/react-native-worklets/src/mock.ts",
      "^expo/fetch$": "<rootDir>/__mocks__/expo-fetch.ts",
      "^expo-sqlite$": "<rootDir>/__mocks__/expo-sqlite.ts",
      "^expo-file-system/legacy$": "<rootDir>/__mocks__/expo-file-system.ts",
      "^expo-network$": "<rootDir>/__mocks__/expo-network.ts",
      "^expo-crypto$": "<rootDir>/__mocks__/expo-crypto.ts",
      "^expo-secure-store$": "<rootDir>/__mocks__/expo-secure-store.ts",
      "^expo-asset$": "<rootDir>/__mocks__/expo-asset.ts",
      "^expo-image$": "<rootDir>/__mocks__/expo-image.tsx",
      "^expo-document-picker$": "<rootDir>/__mocks__/expo-document-picker.ts",
      "^@expo/vector-icons$": "<rootDir>/__mocks__/expo-vector-icons.tsx",
      "^react-native-executorch$": "<rootDir>/__mocks__/react-native-executorch.ts",
      "^react-native-executorch-expo-resource-fetcher$": "<rootDir>/__mocks__/react-native-executorch-expo-resource-fetcher.ts",
      "^react-native-audio-api$": "<rootDir>/__mocks__/react-native-audio-api.ts",
      "^react-native-nitro-google-signin$": "<rootDir>/__mocks__/react-native-nitro-google-signin.ts"
    }
  }
}
