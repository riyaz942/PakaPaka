+    // PakaPaka patch: the pool VFS keeps its OPFS access handles for as long as
+    // the worker lives, and a page in the browser's back/forward cache keeps
+    // its worker. A fresh load of the app then cannot open the databases.
+    // Stop the worker as the page hides, the same as when a tab closes. A page
+    // restored from that cache has no worker state and must reload
+    // (DatabaseProvider does this).
+    window.addEventListener(
+      'pagehide',
+      () => {
+        worker?.terminate();
+        worker = null;
+      },
+      { once: true }
+    );
   }
   return worker;
 }
