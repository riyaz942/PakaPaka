{
  "expo": {
    "name": "PakaPaka",
    "slug": "pakapaka",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "pakapaka",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.pakapaka.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCF2E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pakapaka.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-screen-orientation",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCF2E5",
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#1B1917",
            "image": "./assets/images/icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-asset",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Lets you speak Japanese during conversation practice. Speech is transcribed on this device by default. If you turn on cloud transcription in Settings, audio is sent only to the HTTPS endpoint you configured with your own key.",
          "androidPermissions": [
            "android.permission.RECORD_AUDIO"
          ],
          "iosBackgroundMode": false,
          "androidForegroundService": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 33
          }
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "riyaz942",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a1088e36-2a82-4e17-afcc-37a21181b635"
      }
    }
  }
}
