{
  "expo": {
    "name": "Kizamu",
    "slug": "kizamu",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "kizamu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/kizamu.icon",
      "bundleIdentifier": "com.kizamu.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E23E32",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kizamu.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-screen-orientation",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5F2",
          "dark": {
            "backgroundColor": "#1B1917"
          },
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200,
            "dark": {
              "image": "./assets/images/splash-icon.png"
            }
          }
        }
      ],
      "expo-sqlite",
      "expo-asset",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Lets you speak Japanese during conversation practice. Speech is transcribed on this device by default. If you turn on cloud transcription in Settings, audio is sent only to the HTTPS endpoint you configured with your own key.",
          "androidPermissions": ["android.permission.RECORD_AUDIO"],
          "iosBackgroundMode": false,
          "androidForegroundService": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 33
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4998d58c-4b3f-4d72-81c6-9eb97c427935"
      }
    },
    "owner": "riyaz942"
  }
}
