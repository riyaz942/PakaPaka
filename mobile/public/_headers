/landing/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-wABnzWGZVAVk2BDdSVP6Z+CWIZjceBqrOuPSBVPRAZE=' 'sha256-v2oWTCMqZZr5rnkdKk6xYPY3TZ5i+JSe5u3HAq2UyS8='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'
