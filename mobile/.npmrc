# eslint-plugin-react-native-a11y@3.5.1 declares a peerDependency on eslint ^3-^8;
# this project uses eslint ^9.0.0. The plugin works fine at runtime with ESLint 9
# (verified: `npm run lint` passes), but a strict peer-dep resolution makes `npm ci`
# fail with ERESOLVE on a clean install (e.g. in CI). Revisit if the plugin ships
# an ESLint 9-compatible peerDependencies range.
legacy-peer-deps=true
